{
  "name": "aztu-kabinet-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-assets": "node scripts/prepare.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "node scripts/prepare.mjs && wrangler dev --port 8787",
    "deploy": "node scripts/prepare.mjs && wrangler deploy",
    "build": "node scripts/prepare.mjs && wrangler deploy --dry-run --outdir .wrangler/build"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  }
}
